flowchart LR
    %% Estilos generales
    classDef base fill:#f8fafc,stroke:#334155,stroke-width:1.5px,color:#0f172a;
    classDef corpus fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef varR1 fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef varR2 fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef varC0 fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,stroke-dasharray: 4 4,color:#6b21a8;
    classDef varB fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#991b1b;
    classDef output fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#1e293b;

    subgraph INGESTA ["1. Ingesta"]
        direction TB
        D1["Corpus Documental<br/>(PDF, DOCX, MD)"]:::corpus
        D2["Extracción con Localizadores<br/>(página, sección, línea)"]:::base
        D1 --> D2
    end

    subgraph FRAGMENTACION ["2. Fragmentación"]
        direction TB
        F1["Fija R0/R2/C0/B<br/>400 tok, solape 60"]:::base
        F2["[R1] Pequeños<br/>200 tok, solape 30"]:::varR1
    end

    subgraph INDEXACION ["3. Vectorización e Indexación"]
        direction TB
        E1["Embeddings base<br/>R0/R1/R2/C0/B_LLM<br/>multilingual-e5-small (384d)"]:::base
        E2["[B_EMB] Alternativo<br/>BAAI/bge-m3 (1024d)"]:::varB
        IDX[("Índice Vectorial Denso<br/>L2 / Coseno")]:::base
        E1 --> IDX
        E2 -.-> IDX
    end

    subgraph CONSULTA ["4. Consulta y Recuperación"]
        direction TB
        Q["Pregunta del Usuario<br/>(Directa / Multidoc / Sin respuesta)"]:::base
        R_BASE["Top-k base R0/R1/B<br/>k = 4"]:::base
        R_K8["[R2] Ampliada<br/>k = 8"]:::varR2
        C0_NODE["[C0] Sin RAG<br/>k = 0, sin documentos"]:::varC0
    end

    subgraph CONTEXTO ["5. Ensamblado de Contexto"]
        direction TB
        CTX["Contexto con etiquetas [F1]..[Fk]<br/>Límite 2400 tokens<br/>(recorte si excede)"]:::base
    end

    subgraph GENERACION ["6. Inferencia y Generación"]
        direction TB
        PROMPT["Prompt del sistema<br/>solo contexto · citar [F#]<br/>abstenerse si falta evidencia"]:::base
        LLM1["LLM base R0/R1/R2/C0/B_EMB<br/>nvidia/nemotron-3.5-lightning:free<br/>temp=0 · máx 512 tok · seed=42"]:::base
        LLM2["[B_LLM] LLM alternativo<br/>nvidia/nemotron-3-ultra-550b-a55b:free<br/>temp=0 · máx 512 tok · seed=42"]:::varB
    end

    subgraph RESPUESTA ["7. Salida"]
        direction TB
        RESP_OK["Respuesta con citas [F#]<br/>precisa y completa"]:::output
        RESP_ABS["Abstención<br/>EVIDENCIA INSUFICIENTE:"]:::output
    end

    %% Conexiones entre etapas
    D2 --> F1
    D2 -.-> F2
    F1 --> E1
    F2 -.-> E1
    F1 -.-> E2
    IDX --> R_BASE
    IDX --> R_K8
    Q --> R_BASE
    Q -.-> R_K8
    Q -.-> C0_NODE
    R_BASE --> CTX
    R_K8 -.-> CTX
    CTX --> PROMPT
    PROMPT --> LLM1
    PROMPT -.-> LLM2
    C0_NODE -.-> LLM1
    LLM1 --> RESP_OK
    LLM1 --> RESP_ABS
    LLM2 -.-> RESP_OK
    LLM2 -.-> RESP_ABS
